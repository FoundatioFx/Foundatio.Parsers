<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\common.props" />
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Foundatio.Parsers.LuceneQueries\Extensions\TaskExtensions.cs" Link="Extensions\TaskExtensions.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <!-- Microsoft.Data.SqlClient (via EF Core SqlServer) pulls in a vulnerable System.Security.Cryptography.Pkcs
         (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). 9.0.21 is the minimum patched 9.x version.
         Remove once SqlClient depends on a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <PackageReference Include="Exceptionless.DateTimeExtensions" Version="6.1.0" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.4" />
  </ItemGroup>
  <ItemGroup>
      <ProjectReference Include="..\..\src\Foundatio.Parsers.LuceneQueries\Foundatio.Parsers.LuceneQueries.csproj" />
  </ItemGroup>
</Project>
