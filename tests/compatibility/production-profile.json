{
  "version": 1,
  "name": "exceptionless-derived-query-contract",
  "sources": [
    {
      "repository": "exceptionless/Exceptionless",
      "commit": "deffcf18550f38813823e0ed9be4e83d04ad3f66",
      "path": "src/Exceptionless.Core/Repositories/Configuration/Indexes/EventIndex.cs",
      "scope": "Selected scalar mappings, mapping aliases, lowerkeyword/standardplus/whitespace_lower analysis and a seven-field projection of the default search fields. Not the complete EventIndex or its custom visitors."
    },
    {
      "repository": "FoundatioFx/Foundatio.Repositories",
      "commit": "a61d541613528428cc00bc2236602db72948a924",
      "path": "src/Foundatio.Repositories.Elasticsearch/Configuration/Index.cs",
      "scope": "Server mapping resolver, field resolver and UseNested composition."
    }
  ],
  "supplemental": [
    "msg/who field-map aliases and vip include are test configuration, not deployed Exceptionless aliases/macros.",
    "children, folded, ignored, nullable and date_nanos are adversarial controls, not claims about EventIndex mappings.",
    "One shard and zero replicas isolate score comparisons; distributed scoring and production capacity are outside this profile."
  ],
  "defaultFields": ["id", "reference", "reference_id", "source", "message", "tags"],
  "fieldMap": {"msg": "message", "who": "children.name"},
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "index.mapping.ignore_malformed": true,
    "analysis": {
      "analyzer": {
        "lowerkeyword": {"type": "custom", "tokenizer": "keyword", "filter": ["lowercase"]},
        "whitespace_lower": {"type": "custom", "tokenizer": "comma_whitespace", "filter": ["lowercase"]},
        "standardplus": {"type": "custom", "tokenizer": "comma_whitespace", "filter": ["standardplus", "lowercase", "unique"]}
      },
      "tokenizer": {
        "comma_whitespace": {"type": "char_group", "tokenize_on_chars": [",", "whitespace"]}
      },
      "filter": {
        "standardplus": {
          "type": "pattern_capture",
          "preserve_original": true,
          "patterns": [
            "([^\\.\\(\\)\\[\\]\\/\\\\\\{\\}\\?=&;:\\<\\>]+)",
            "([^\\.\\(\\)\\[\\]\\/\\\\\\{\\}\\?=&;:\\<\\>]+[\\.\\/\\\\][^\\.\\(\\)\\[\\]\\/\\\\\\{\\}\\?=&;:\\<\\>]+)",
            "([^\\.\\(\\)\\[\\]\\/\\\\\\{\\}\\?=&;:\\<\\>]+[\\.\\/\\\\][^\\.\\(\\)\\[\\]\\/\\\\\\{\\}\\?=&;:\\<\\>]+[\\.\\/\\\\][^\\.\\(\\)\\[\\]\\/\\\\\\{\\}\\?=&;:\\<\\>]+)"
          ]
        }
      },
      "normalizer": {
        "folded": {"type": "custom", "filter": ["lowercase", "asciifolding"]}
      }
    }
  },
  "mapping": {
    "dynamic": false,
    "properties": {
      "id": {"type": "keyword"},
      "organization_id": {"type": "keyword"},
      "organization": {"type": "alias", "path": "organization_id"},
      "project_id": {"type": "keyword"},
      "project": {"type": "alias", "path": "project_id"},
      "reference_id": {"type": "keyword"},
      "reference": {"type": "alias", "path": "reference_id"},
      "message": {"type": "text"},
      "source": {"type": "text", "analyzer": "standardplus", "search_analyzer": "whitespace_lower"},
      "tags": {"type": "text", "analyzer": "lowerkeyword"},
      "tag": {"type": "alias", "path": "tags"},
      "count": {"type": "integer"},
      "value": {"type": "double"},
      "is_first_occurrence": {"type": "boolean"},
      "first": {"type": "alias", "path": "is_first_occurrence"},
      "date": {"type": "date"},
      "date_nanos": {"type": "date_nanos"},
      "folded": {"type": "keyword", "normalizer": "folded"},
      "ignored": {"type": "keyword", "ignore_above": 5},
      "nullable": {"type": "keyword", "null_value": "MISSING"},
      "children": {
        "type": "nested",
        "properties": {
          "name": {"type": "keyword"},
          "state": {"type": "keyword"},
          "visible": {"type": "boolean"}
        }
      }
    }
  },
